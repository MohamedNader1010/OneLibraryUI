{
    "useTabs": false,
    "tabWidth": 4,
    "trailingComma": "none",
    "semi": true,
    "singleQuote": true,
    "printWidth": 135,
    "bracketSameLine": false,
    "overrides": [
        {
            "files": ["*.ts", "*.mts", "*.d.ts"],
            "options": {
                "parser": "typescript"
            }
        },
        {
            "files": ["*.html"],
            "options": {
                "parser": "html",
                "printWidth": 135,
                "bracketSameLine": true
            }
        },
        {
            "files": ["*.component.html"],
            "options": {
                "parser": "angular",
                "printWidth": 135,
                "bracketSameLine": true
            }
        }
    ]
}
